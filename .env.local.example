# 이 파일을 복사해서 .env.local 로 만들고 값을 채우세요. (.env.local 은 깃에 올리지 마세요)

# Turso DB — 필수
#   turso db show <DB이름> --url      → TURSO_DATABASE_URL
#   turso db tokens create <DB이름>   → TURSO_AUTH_TOKEN
# 둘 다 채운 뒤 `npm run db:migrate` 로 테이블을 만듭니다.
TURSO_DATABASE_URL=libsql://avatar-money-사용자이름.turso.io
TURSO_AUTH_TOKEN=여기에_토큰

# (현재 코드에서는 쓰지 않음) 세션 토큰은 DB에 저장되는 랜덤값이라 서명 키가 필요 없습니다.
# 나중에 서명 쿠키 방식으로 바꿀 때를 위해 남겨둡니다.
SESSION_SECRET=

# Google 애드센스 (승인 후 입력, 없으면 광고 미표시)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
