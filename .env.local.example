# 이 파일을 복사해서 .env.local 로 만들고 값을 채우세요. (.env.local 은 깃에 올리지 마세요)

# Turso DB (turso db show / tokens create 로 발급)
TURSO_DATABASE_URL=libsql://avatar-money-사용자이름.turso.io
TURSO_AUTH_TOKEN=여기에_토큰

# 세션 서명용 임의의 긴 랜덤 문자열
SESSION_SECRET=아무_길고_랜덤한_문자열

# Google 애드센스 (승인 후 입력, 없으면 광고 미표시)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
